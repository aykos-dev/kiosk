{
  "mode": "development",
  "kiosk": {
    "fullscreen": false,
    "inactivityTimeout": 300000,
    "windowWidth": 1080,
    "windowHeight": 1920,
    "minWindowWidth": 518,
    "minWindowHeight": 900
  },
  "hardware": {
    "paymentTerminals": {
      "humo": {
        "enabled": true,
        "port": "COM3",
        "baudRate": 9600,
        "useMock": true,
        "allowMockInProduction": true
      },
      "uzcard": {
        "enabled": true,
        "port": "COM4",
        "baudRate": 9600,
        "useMock": true,
        "allowMockInProduction": true
      }
    },
    "printer": {
      "enabled": true,
      "vendorId": "0x1234",
      "productId": "0x5678",
      "charsPerLine": 48,
      "useMock": true
    }
  },
  "api": {
    "baseUrl": "https://devio.bellissimo.uz/api",
    "timeout": 5000,
    "retryAttempts": 1
  }
}
